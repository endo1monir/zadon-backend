    {
      "name": "Vendor Dashboard API (/api/vendor)",
      "description": "Endpoints used by the vendor store dashboard.",
      "item": [
        {
          "name": "Register Vendor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/vendor/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "vendor", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pharmacy Owner\",\n  \"phone\": \"0555123456\",\n  \"email\": \"vendor@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"store\": {\n    \"name_ar\": \"صيدلية النور\",\n    \"name_en\": \"Al Noor Pharmacy\",\n    \"category_id\": 1,\n    \"city\": \"Riyadh\",\n    \"address_ar\": \"الرياض، حي العليا، شارع الملك فهد\",\n    \"phone\": \"0112345678\",\n    \"cr_number\": \"1010123456\",\n    \"vat_number\": \"310121234500003\",\n    \"manager_name\": \"Ali Hassan\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Create a vendor user + store. Returns a token (ability `vendor`) — auto-saved to `vendor_token`. `store.category_id` must reference an existing store-type category."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('vendor_token', json.token); }"
                ]
              }
            }
          ]
        },
